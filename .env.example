DJANGO_DEBUG=1
# Required for production. Generate a unique key and store it in your environment.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=
TRUST_HTTPS_PROXY=0

# Leave DATABASE_URL unset for local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL_REQUIRE=1

# Local development defaults to the console backend.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=CampusConnect <noreply@example.com>

# Leave AWS_STORAGE_BUCKET_NAME unset for local media.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
